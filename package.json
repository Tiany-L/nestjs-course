{
  "name": "nestjs-learning-notes",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A Chinese, content-first NestJS course built with VitePress.",
  "packageManager": "pnpm@11.0.8",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "scripts": {
    "docs:dev": "vitepress dev docs --host 0.0.0.0",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs --host 0.0.0.0",
    "check": "node scripts/check-content.mjs && markdownlint-cli2 \"docs/**/*.md\"",
    "test:ui": "playwright test",
    "test": "pnpm check && pnpm docs:build && pnpm test:ui"
  },
  "devDependencies": {
    "@lucide/vue": "1.34.0",
    "@playwright/test": "1.62.1",
    "@types/node": "26.3.0",
    "markdownlint-cli2": "0.23.2",
    "vitepress": "1.6.4",
    "vue": "3.5.41"
  }
}
